# Base URL of the Django REST API that the frontend talks to.
#
# This is the BACKEND URL, not the site's own address. The Vercel URL
# (https://mahnoor-savora-one.vercel.app) serves this React app; it does not run
# Django, so it must never be used here.
#
# Local development (copy this file to .env to use it):
VITE_API_BASE_URL=http://127.0.0.1:8000
#
# In Vercel -> Settings -> Environment Variables, set this to where Django is
# hosted. For this project that is:
#VITE_API_BASE_URL=https://savora-api-x64l.onrender.com
#
# Leaving it unset in Vercel is also safe: src/api.js falls back to the Render
# URL above for any production build, and only uses 127.0.0.1 for `npm run dev`.
#
# No trailing slash: paths are appended directly (e.g. `${API_BASE}/menu/`).
#
# Vite only exposes variables prefixed with VITE_, and it inlines them at build
# time, so change this and redeploy for it to take effect.
